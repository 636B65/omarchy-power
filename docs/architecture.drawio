<mxfile host="drawio" type="device"><diagram id="arch" name="Architecture"><mxGraphModel dx="1260" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1260" pageHeight="700" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;omarchy-power 2.0 — architecture&lt;/b&gt;" style="text;html=1;fontSize=18;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="500" height="30" as="geometry"/></mxCell><mxCell id="lu" value="User session (Hyprland + omarchy-shell)" style="swimlane;html=1;startSize=30;fontSize=14;fontStyle=1;rounded=1;arcSize=2;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#f4f8fd;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="840" height="470" as="geometry"/></mxCell><mxCell id="builtin" value="&lt;b&gt;omarchy.idle&lt;/b&gt; (built-in)&lt;br&gt;screensaver at 5 min, lock at 10 min" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="lu"><mxGeometry x="20" y="50" width="240" height="70" as="geometry"/></mxCell><mxCell id="shelljson" value="&lt;b&gt;~/.config/omarchy/shell.json&lt;/b&gt;&lt;br&gt;• idle.screensaver / idle.lock&lt;br&gt;• plugins[] → omarchy-power.idle-sleep&lt;br&gt;&amp;nbsp;&amp;nbsp;acAction, acTimeout&lt;br&gt;&amp;nbsp;&amp;nbsp;batteryAction, batteryTimeout" style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lu"><mxGeometry x="20" y="170" width="240" height="110" as="geometry"/></mxCell><mxCell id="plugin" value="omarchy-power.idle-sleep (shell service plugin)" style="swimlane;html=1;startSize=30;fontSize=14;fontStyle=1;rounded=1;arcSize=2;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#f3faf1;" vertex="1" parent="lu"><mxGeometry x="340" y="50" width="480" height="400" as="geometry"/></mxCell><mxCell id="idlemon" value="&lt;b&gt;IdleMonitor&lt;/b&gt; (ext-idle-notify)&lt;br&gt;away after 10 s without input" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="plugin"><mxGeometry x="20" y="45" width="210" height="60" as="geometry"/></mxCell><mxCell id="upower" value="&lt;b&gt;UPower OnBattery&lt;/b&gt;&lt;br&gt;picks the AC or battery profile" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="plugin"><mxGeometry x="250" y="45" width="210" height="60" as="geometry"/></mxCell><mxCell id="lockprobe" value="&lt;b&gt;Lock probe + screensaver window&lt;/b&gt;&lt;br&gt;activity while locked or under the&lt;br&gt;screensaver does not end away" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="plugin"><mxGeometry x="20" y="125" width="210" height="70" as="geometry"/></mxCell><mxCell id="deadline" value="&lt;b&gt;Deadline timer&lt;/b&gt;&lt;br&gt;away ≥ timeout of the&lt;br&gt;current power source" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="plugin"><mxGeometry x="250" y="125" width="210" height="70" as="geometry"/></mxCell><mxCell id="action" value="&lt;b&gt;Action script&lt;/b&gt;&lt;br&gt;1. Stay Awake on → skip, retry&lt;br&gt;2. logind &lt;i&gt;idle&lt;/i&gt; block inhibitor → skip, retry&lt;br&gt;3. &lt;code&gt;systemctl suspend&lt;/code&gt; (or the configured action)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="plugin"><mxGeometry x="20" y="220" width="440" height="110" as="geometry"/></mxCell><mxCell id="back" value="Unlock, or activity while unlocked with no screensaver → back; the timer resets" style="text;html=1;fontSize=11;fontStyle=2;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="plugin"><mxGeometry x="20" y="340" width="440" height="45" as="geometry"/></mxCell><mxCell id="ls" value="System (root)" style="swimlane;html=1;startSize=30;fontSize=14;fontStyle=1;rounded=1;arcSize=2;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#fff8f0;" vertex="1" parent="1"><mxGeometry x="900" y="50" width="340" height="470" as="geometry"/></mxCell><mxCell id="lid" value="Lid switch" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="ls"><mxGeometry x="20" y="50" width="130" height="50" as="geometry"/></mxCell><mxCell id="suspend" value="&lt;b&gt;Suspend&lt;/b&gt;&lt;br&gt;(Omarchy locks first)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="ls"><mxGeometry x="190" y="50" width="130" height="50" as="geometry"/></mxCell><mxCell id="logind" value="&lt;b&gt;systemd-logind&lt;/b&gt;&lt;br&gt;picks the lid key by power source" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="ls"><mxGeometry x="20" y="160" width="300" height="70" as="geometry"/></mxCell><mxCell id="dropin" value="&lt;b&gt;/etc/systemd/logind.conf.d/20-omarchy-power.conf&lt;/b&gt;&lt;br&gt;HandleLidSwitch=suspend &amp;nbsp;(battery)&lt;br&gt;HandleLidSwitchExternalPower=ignore &amp;nbsp;(AC)&lt;br&gt;HandleLidSwitchDocked=ignore &amp;nbsp;(docked)" style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="ls"><mxGeometry x="20" y="300" width="300" height="110" as="geometry"/></mxCell><mxCell id="tui" value="&lt;b&gt;omarchy-power-config&lt;/b&gt;&lt;br&gt;TUI, run in a terminal" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="240" height="70" as="geometry"/></mxCell><mxCell id="installer" value="&lt;b&gt;install.sh&lt;/b&gt; (sudo)&lt;br&gt;installs plugin, drop-in and TUI&lt;br&gt;removes the 1.x udev rule / service" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="920" y="560" width="300" height="70" as="geometry"/></mxCell><mxCell id="e_tui_json" value="writes (user)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="tui" target="shelljson"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_tui_dropin" value="writes drop-in + reloads logind (sudo)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="tui" target="dropin"><mxGeometry x="-0.3" relative="1" as="geometry"><Array as="points"><mxPoint x="880" y="595"/><mxPoint x="880" y="405"/></Array></mxGeometry></mxCell><mxCell id="e_tui_restart" value="restarts shell&lt;br&gt;when delays change" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;align=left;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="tui" target="builtin"><mxGeometry x="-0.45" relative="1" as="geometry"><Array as="points"><mxPoint x="30" y="595"/><mxPoint x="30" y="135"/></Array><mxPoint x="62" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e_json_builtin" value="delays" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="shelljson" target="builtin"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_json_plugin" value="settings&lt;br&gt;(live)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.63;entryDx=0;entryDy=0;" edge="1" parent="1" source="shelljson" target="plugin"><mxGeometry x="0.15" relative="1" as="geometry"><mxPoint x="0" y="18" as="offset"/></mxGeometry></mxCell><mxCell id="e_blips" value="activity blips&lt;br&gt;(ignored)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="builtin" target="lockprobe"><mxGeometry x="0.1" relative="1" as="geometry"><Array as="points"><mxPoint x="320" y="135"/><mxPoint x="320" y="260"/></Array></mxGeometry></mxCell><mxCell id="e_deadline_action" value="due" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.77;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="deadline" target="action"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_action_logind" value="systemctl suspend" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="action" target="logind"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="880" y="375"/><mxPoint x="880" y="245"/></Array></mxGeometry></mxCell><mxCell id="e_lid_logind" value="lid closed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArro