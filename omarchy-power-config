#!/usr/bin/env python3
"""TUI to configure omarchy-power behavior.

Edits, per power source (AC / battery), what systemd-logind should do on idle
and on lid close, plus the Omarchy shell idle timings (screensaver / lock).

Saving applies the changes:

  - /etc/omarchy-power/power.conf                      (root, via sudo/pkexec)
  - /etc/systemd/logind.conf.d/20-user-power-behavior.conf, by running
    switch-power-behavior.sh (root, via sudo/pkexec)
  - ~/.config/omarchy/shell.json                       (user, direct)

Only the Python standard library is used; no external dependencies.
"""

from __future__ import annotations

import curses
import json
import os
import pwd
import shutil
import subprocess
import sys
import tempfile

APP_TITLE = "omarchy power config"

LOGIND_ACTIONS = [
    "ignore",
    "poweroff",
    "reboot",
    "halt",
    "suspend",
    "hibernate",
    "hybrid-sleep",
    "suspend-then-hibernate",
    "lock",
    "kexec",
]

POWER_CONF_PATH = "/etc/omarchy-power/power.conf"

DEFAULTS = {
    "ac": {
        "idle_action": "ignore",
        "idle_action_sec": 0,
        "lid_switch": "ignore",
        "lid_switch_external_power": "ignore",
        "lid_switch_docked": "ignore",
    },
    "battery": {
        "idle_action": "suspend",
        "idle_action_sec": 1800,
        "lid_switch": "suspend",
        "lid_switch_external_power": "suspend",
        "lid_switch_docked": "ignore",
    },
}

SHELL_IDLE_DEFAULTS = {"screensaver_sec": 300, "lock_sec": 600}

CONF_KEYS = [
    ("IDLE_ACTION", "idle_action"),
    ("IDLE_ACTION_SEC", "idle_action_sec"),
    ("LID_SWITCH", "lid_switch"),
    ("LID_SWITCH_EXTERNAL_POWER", "lid_switch_external_power"),
    ("LID_SWITCH_DOCKED", "lid_switch_docked"),
]

# Field order and labels for one power-source section.
SECTION_FIELDS = [
    ("idle_action", "Sleep after idle"),
    ("idle_action_sec", "Idle timeout (minutes)"),
    ("lid_switch", "Lid close"),
    ("lid_switch_external_power", "Lid close on external power"),
    ("lid_switch_docked", "Lid close when docked"),
]

SHELL_FIELDS = [
    ("screensaver", "Screensaver delay (minutes)"),
    ("lock", "Screen off / lock (minutes)"),
]


def deep_dupe(obj):
    return json.loads(json.dumps(obj))


def user_home():
    """Home of the human user, even when running under sudo."""
    if os.geteuid() == 0:
        sudo_user = os.getenv("SUDO_USER")
        if sudo_user:
            try:
                return pwd.getpwnam(sudo_user).pw_dir
            except KeyError:
                pass
        return "/root"
    return os.path.expanduser("~")


# --------------------------------------------------------------------------- #
# Power config (KEY=VALUE file read by switch-power-behavior.sh)
# --------------------------------------------------------------------------- #

def render_power_conf(model):
    lines = [
        "# Generated by omarchy-power-config \u2014 read by switch-power-behavior.sh.",
        "# Editing this file by hand while the TUI is open will be overwritten",
        "# the next time it is applied.",
        "",
    ]
    for section in ("ac", "battery"):
        lines.append(f"# Profile while on {section} power.")
        for key, attr in CONF_KEYS:
            lines.append(f"{section.upper()}_{key}={model[section][attr]}")
        lines.append("")
    return "\n".join(lines) + "\n"


def parse_power_conf(text):
    model = deep_dupe(DEFAULTS)
    for raw in text.splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, _, value = line.partition("=")
        key = key.strip().upper()
        value = value.strip()
        for section in ("ac", "battery"):
            prefix = f"{section.upper()}_"
            if key.startswith(prefix):
                attr = key[len(prefix):].lower()
                if attr in model[section]:
                    if attr == "idle_action_sec":
                        try:
                            value = int(value)
                        except ValueError:
                            value = 0
                    model[section][attr] = value
    return model


def load_power_conf(path=POWER_CONF_PATH):
    if os.path.isfile(path):
        with open(path) as fh:
            return parse_power_conf(fh.read())
    return deep_dupe(DEFAULTS)


def load_power_conf_smart():
    """Load config: /etc file, falling back to sudo, repo default, bare defaults."""
    if os.path.isfile(POWER_CONF_PATH):
        return load_power_conf(POWER_CONF_PATH)
    try:
        out = subprocess.run(["sudo", "-n", "cat", POWER_CONF_PATH],
                             capture_output=True, text=True, timeout=5)
        if out.returncode == 0 and out.stdout.strip():
            return parse_power_conf(out.stdout)
    except Exception:
        pass
    repo = os.path.join(os.path.dirname(os.path.abspath(__file__)), "config", "power.conf")
    if os.path.isfile(repo):
        return load_power_conf(repo)
    return deep_dupe(DEFAULTS)


# --------------------------------------------------------------------------- #
# Shell idle config (~/.config/omarchy/shell.json)
# --------------------------------------------------------------------------- #

def shell_json_path(home=None):
    return os.path.join(home or user_home(), ".config", "omarchy", "shell.json")


def load_shell_data():
    with open(shell_json_path()) as fh:
        return json.load(fh)


def read_shell_idle(data):
    idle = data.get("idle") or {}
    return {
        "screensaver": int(idle.get("screensaver", SHELL_IDLE_DEFAULTS["screensaver_sec"])),
        "lock": int(idle.get("lock", SHELL_IDLE_DEFAULTS["lock_sec"])),
    }


def write_shell_idle(data, screensaver, lock):
    idle = dict(data.get("idle") or {})
    idle["screensaver"] = int(screensaver)
    idle["lock"] = int(lock)
    data["idle"] = idle
    return data


# --------------------------------------------------------------------------- #
# System glue
# --------------------------------------------------------------------------- #

def detect_power_source():
    try:
        out = subprocess.run(
            ["busctl", "get-property", "org.freedesktop.UPower",
             "/org/freedesktop/UPower", "org.freedesktop.UPower", "OnBattery"],
            capture_output=True, text=True, timeout=3,
        ).stdout.lower()
        if "true" in out:
            return "battery"
        if "false" in out:
            return "ac"
    except Exception:
        pass
    try:
        for name in os.listdir("/sys/class/power_supply"):
            base = f"/sys/class/power_supply/{name}"
            try:
                with open(f"{base}/type") as fh:
                    if fh.read().strip() != "Mains":
                        continue
                with open(f"{base}/online") as fh:
                    if fh.read().strip() == "1":
                        return "ac"
            except OSError:
                continue
        return "battery"
    except OSError:
        return "unknown"


def sudo_prefix():
    if os.geteuid() == 0:
        return []
    if shutil.which("sudo"):
        return ["sudo"]
    if shutil.which("pkexec"):
        return ["pkexec"]
    return None


def behavior_script():
    candidate = shutil.which("omarchy-power-behavior")
    if candidate:
        return candidate
    if os.path.exists("/usr/local/bin/omarchy-power-behavior"):
        return "/usr/local/bin/omarchy-power-behavior"
    here = os.path.dirname(os.path.abspath(__file__))
    local = os.path.join(here, "switch-power-behavior.sh")
    if os.path.exists(local):
        return local
    return None


def run_step(cmd):
    print(f"\n> {' '.join(cmd)}")
    result = subprocess.call(cmd)
    if result != 0:
        raise SystemExit(f"command failed with exit code {result}: {' '.join(cmd)}")


def apply_changes(model, data):
    """Write power.conf + logind drop-in (root) and user shell.json."""
    with tempfile.TemporaryDirectory(prefix="omarchy-power-") as tmp:
        power_tmp = os.path.join(tmp, "power.conf")
        with open(power_tmp, "w") as fh:
            fh.write(render_power_conf(model))

        shell_tmp = os.path.join(tmp, "shell.json")
        with open(shell_tmp, "w") as fh:
            json.dump(data, fh, indent=2)
            fh.write("\n")

        prefix = sudo_prefix()
        if prefix is None:
            raise SystemExit("no privilege helper (sudo or pkexec) found to write /etc")

        run_step(prefix + ["install", "-m", "0644", "-D", power_tmp, POWER_CONF_PATH])

        script = behavior_script()
        if script:
            run_step(prefix + ["bash", script])

        sjson = shell_json_path()
        os.makedirs(os.path.dirname(sjson), exist_ok=True)
        shutil.copyfile(shell_tmp, sjson)
        if os.geteuid() == 0 and os.getenv("SUDO_USER"):
            shutil.chown(sjson, os.getenv("SUDO_USER"), os.getenv("SUDO_USER"))
        print(f"\n> wrote {sjson}")

        print("\nDone. logind was reloaded; the change is active immediately.")


# --------------------------------------------------------------------------- #
# TUI
# --------------------------------------------------------------------------- #

C_NORMAL = 1
C_TITLE = 2
C_OK = 3
C_WARN = 4
C_ERR = 5
C_DIM = 6


def setup_colors(stdscr):
    if not curses.has_colors():
        return
    curses.start_color()
    try:
        curses.use_default_colors()
    except curses.error:
        pass
    curses.init_pair(C_NORMAL, -1, -1)
    curses.init_pair(C_TITLE, curses.COLOR_CYAN, -1)
    curses.init_pair(C_OK, curses.COLOR_GREEN, -1)
    curses.init_pair(C_WARN, curses.COLOR_YELLOW, -1)
    curses.init_pair(C_ERR, curses.COLOR_RED, -1)
    curses.init_pair(C_DIM, 8, -1)


class App:
    def __init__(self, stdscr, model, data):
        self.stdscr = stdscr
        self.model = model
        self.data = data
        self.sel = 0
        self.scroll = 0
        self.status = ""
        self.status_color = C_DIM
        self.saved = snapshot(model, data)
        self.quit = False
        self.power_source = detect_power_source()
        self.maxy, self.maxx = stdscr.getmaxyx()

    # -- rows -------------------------------------------------------------- #
    def rows(self):
        rows = []  # (kind, payload) kind in {"head", "field", "shell"}
        for section, title in (("ac", "AC adapter (plugged in)"),
                               ("battery", "Battery (unplugged)")):
            rows.append(("head", title))
            for attr, label in SECTION_FIELDS:
                rows.append(("field", (section, attr, label)))
        rows.append(("head", "Omarchy shell idle"))
        for attr, label in SHELL_FIELDS:
            rows.append(("shell", (attr, label)))
        return rows

    def is_enum(self, row):
        kind, payload = row
        return kind == "field" and payload[1] != "idle_action_sec"

    def field_value(self, row):
        kind, payload = row
        if kind == "field":
            section, attr, _ = payload
            val = self.model[section][attr]
            if attr == "idle_action_sec":
                return f"{val // 60}"
            return val
        if kind == "shell":
            attr, _ = payload
            return str(read_shell_idle(self.data)[attr] // 60)
        return ""

    def field_set(self, row, value):
        kind, payload = row
        if kind == "field":
            section, attr, _ = payload
            if attr == "idle_action_sec":
                self.model[section][attr] = int(value) * 60
            else:
                self.model[section][attr] = value
            return
        if kind == "shell":
            attr, _ = payload
            idle = read_shell_idle(self.data)
            idle[attr] = int(value) * 60
            write_shell_idle(self.data, idle["screensaver"], idle["lock"])

    # -- events ------------------------------------------------------------ #
    def move(self, delta):
        rows = self.rows()
        total = len(rows) - 1
        self.sel = max(0, min(total, self.sel + delta))
        page = max(self.maxy - 3, 1)
        if self.sel < self.scroll:
            self.scroll = self.sel
        elif self.sel >= self.scroll + page:
            self.scroll = self.sel - page + 1

    def handle(self, ch):
        rows = self.rows()
        kind, payload = rows[self.sel]
        if ch in (ord("q"), 27):
            if self.dirty():
                if yesno(self.stdscr, "Quit", "You have unsaved changes.\nQuit anyway?"):
                    self.quit = True
            else:
                self.quit = True
        elif ch in (curses.KEY_UP, ord("k")):
            self.move(-1)
        elif ch in (curses.KEY_DOWN, ord("j")):
            self.move(1)
        elif ch in (curses.KEY_ENTER, 10, 13, curses.KEY_RIGHT, ord("l")):
            if kind in ("field", "shell"):
                if self.is_enum(rows[self.sel]):
                    options = LOGIND_ACTIONS
                    current = self.field_value(rows[self.sel])
                    idx = options.index(current) if current in options else 0
                    chosen = pick_option(self.stdscr, "Choose action", options, idx)
                    if chosen is not None:
                        self.field_set(rows[self.sel], options[chosen])
                        self.status = ""
                else:
                    result = number_input(
                        self.stdscr, "Enter minutes", self.field_value(rows[self.sel]))
                    if result is not None:
                        self.field_set(rows[self.sel], result)
                        self.status = ""
        elif ch in (curses.KEY_LEFT, ord("h")):
            if kind in ("field", "shell") and self.is_enum(rows[self.sel]):
                options = LOGIND_ACTIONS
                current = self.field_value(rows[self.sel])
                idx = options.index(current) if current in options else 0
                self.field_set(rows[self.sel], options[(idx - 1) % len(options)])
                self.status = ""
        elif ch in (ord("a"), ord("A")):
            self.do_apply()
        elif ch in (ord("r"), ord("R")):
            if yesno(self.stdscr, "Reset",
                     "Reset to the repository defaults? Changes are applied\n"
                     "only after you press a."):
                self.model = deep_dupe(DEFAULTS)
                write_shell_idle(self.data,
                                 SHELL_IDLE_DEFAULTS["screensaver_sec"],
                                 SHELL_IDLE_DEFAULTS["lock_sec"])
                self.status = "Reset to defaults. Press a to apply."
                self.status_color = C_WARN
        elif ch == curses.KEY_RESIZE:
            self.maxy, self.maxx = self.stdscr.getmaxyx()
        else:
            self.show_status("a apply \u00b7 r reset defaults \u00b7 q quit", C_DIM)

    def dirty(self):
        return snapshot(self.model, self.data) != self.saved

    def show_status(self, text, color):
        self.status = text
        self.status_color = color

    def do_apply(self):
        if not self.dirty():
            self.show_status("Nothing to apply \u2014 no changes yet.", C_WARN)
            return
        self.show_status("Applying\u2026", C_DIM)
        self.draw()
        suspend_tui(self.stdscr)
        try:
            apply_changes(self.model, self.data)
            self.saved = snapshot(self.model, self.data)
            self.show_status("Applied. Settings are active now.", C_OK)
        except SystemExit as exc:
            self.show_status(f"Apply failed: {exc}\nPress any key to continue", C_ERR)
            self.stdscr.getch()
        finally:
            resume_tui(self.stdscr)

    # -- drawing ----------------------------------------------------------- #
    def draw(self):
        self.maxy, self.maxx = self.stdscr.getmaxyx()
        stdscr = self.stdscr
        stdscr.erase()

        header = f" {APP_TITLE} \u2014 power: {self.power_source}"
        if self.dirty():
            header += "  [unsaved]"
        try:
            stdscr.addnstr(0, 0, header, self.maxx,
                           curses.color_pair(C_TITLE) | curses.A_BOLD)
        except curses.error:
            pass

        rows = self.rows()
        page = self.maxy - 3
        if page < 1:
            page = 1
        if self.scroll > len(rows) - page:
            self.scroll = max(0, len(rows) - page)
        visible = rows[self.scroll:self.scroll + page]

        max_label = max(len(payload[-1])
                        for kind, payload in rows if kind != "head")
        y = 1
        for row in visible:
            kind, payload = row
            selected = (self.scroll + y - 1) == self.sel
            if kind == "head":
                line = f" {payload}"
                try:
                    stdscr.addnstr(y, 0, line, self.maxx,
                                   curses.color_pair(C_TITLE) | curses.A_BOLD | curses.A_UNDERLINE)
                except curses.error:
                    pass
                y += 1
                continue
            label = payload[-1]
            value = self.field_value(row)
            hint = "*" if self.is_enum(row) else "\u25b6"
            line = f"  {label.ljust(max_label)}  {value}  {hint}"
            attr = curses.A_REVERSE if selected else curses.color_pair(C_NORMAL)
            try:
                stdscr.addnstr(y, 0, line, self.maxx, attr)
            except curses.error:
                pass
            y += 1

        status = self.status or "a apply \u00b7 r reset defaults \u00b7 q quit"
        try:
            stdscr.addnstr(self.maxy - 2, 0, f" {status}", self.maxx,
                           curses.color_pair(self.status_color))
        except curses.error:
            pass

        footer = ("\u2191\u2193 move \u00b7 \u21b2 edit / choose \u00b7 a apply \u00b7 "
                  "r reset \u00b7 q quit")
        try:
            stdscr.addnstr(self.maxy - 1, 0, footer, self.maxx,
                           curses.color_pair(C_DIM))
        except curses.error:
            pass
        stdscr.refresh()


def snapshot(model, data):
    return json.dumps(model, sort_keys=True), json.dumps(data, sort_keys=True)


def suspend_tui(stdscr):
    curses.def_prog_mode()
    curses.endwin()


def resume_tui(stdscr):
    curses.reset_prog_mode()
    stdscr.refresh()


def center_win(stdscr, height, width):
    maxy, maxx = stdscr.getmaxyx()
    height = min(height, maxy)
    width = min(width, maxx)
    if width < 20:
        width = maxx
    win = curses.newwin(height, width,
                        (maxy - height) // 2, (maxx - width) // 2)
    win.bkgd(" ", curses.color_pair(C_NORMAL))
    return win


def popup(stdscr, title, nlines):
    width = min(60, stdscr.getmaxyx()[1] - 2)
    height = nlines + 4
    win = center_win(stdscr, height, width)
    h, w = win.getmaxyx()
    win.box()
    safe_add(win, 1, 1, title, w - 2, curses.color_pair(C_TITLE) | curses.A_BOLD)
    win.refresh()
    return win, h, w


def safe_add(win, y, x, text, maxlen, attr=0):
    try:
        win.addnstr(y, x, text, maxlen, attr)
    except curses.error:
        pass


def pick_option(stdscr, title, options, current):
    win, height, width = popup(stdscr, title, len(options))
    sel = max(0, min(current, len(options) - 1))
    while True:
        win.erase()
        win.box()
        safe_add(win, 1, 1, title, width - 2,
                 curses.color_pair(C_TITLE) | curses.A_BOLD)
        for i, opt in enumerate(options):
            if i >= height - 3:
                break
            line = f"  {opt}".ljust(width - 8)
            attr = curses.A_REVERSE if i == sel else curses.color_pair(C_NORMAL)
            safe_add(win, 2 + i, 1, line, width - 2, attr)
        win.refresh()
        ch = stdscr.getch()
        if ch == curses.KEY_UP:
            sel = max(0, sel - 1)
        elif ch == curses.KEY_DOWN:
            sel = min(len(options) - 1, sel + 1)
        elif ch in (curses.KEY_ENTER, 10, 13, ord(" ")):
            return sel
        elif ch in (27, ord("q")):
            return None


def number_input(stdscr, title, current):
    win, height, width = popup(stdscr, title, 4)
    buf = list(current) if current.isdigit() else []
    old_cursor = curses.curs_set(1)
    try:
        while True:
            win.erase()
            win.box()
            value = "".join(buf) or "0"
            safe_add(win, 1, 1, title, width - 2,
                     curses.color_pair(C_TITLE) | curses.A_BOLD)
            safe_add(win, 2, 1, f"Minutes: {value}", width - 2)
            line = "left/right move, digits edit, ENTER ok, ESC cancel"
            safe_add(win, 3, 1, line, width - 2, curses.color_pair(C_DIM))
            win.move(2, 11 + len(value))
            win.refresh()
            ch = stdscr.getch()
            if ch in (curses.KEY_ENTER, 10, 13):
                try:
                    return max(int("".join(buf) or "0"), 0)
                except ValueError:
                    return None
            elif ch == 27:
                return None
            elif ch in (curses.KEY_BACKSPACE, 8, 127):
                if buf:
                    buf.pop()
            elif 48 <= ch <= 57:
                buf.append(chr(ch))
    finally:
        try:
            curses.curs_set(old_cursor)
        except curses.error:
            pass


def yesno(stdscr, title, message):
    win, height, width = popup(stdscr, title, len(message.splitlines()) + 1)
    while True:
        win.erase()
        win.box()
        safe_add(win, 1, 1, title, width - 2,
                 curses.color_pair(C_TITLE) | curses.A_BOLD)
        for i, line in enumerate(message.splitlines()):
            safe_add(win, 2 + i, 1, line, width - 2)
        safe_add(win, 3 + i + 1, 1, "y=yes  n=no  esc=cancel", width - 2,
                 curses.color_pair(C_DIM))
        win.refresh()
        ch = stdscr.getch()
        if ch in (ord("y"), ord("Y")):
            return True
        if ch in (ord("n"), ord("N"), 27):
            return False


def main():
    model = load_power_conf_smart()
    try:
        data = load_shell_data()
    except (OSError, ValueError):
        data = {"idle": {}}

    def _curses_main(stdscr):
        setup_colors(stdscr)
        try:
            curses.curs_set(0)
        except curses.error:
            pass
        app = App(stdscr, model, data)
        app.draw()
        while not app.quit:
            ch = stdscr.getch()
            app.handle(ch)
            app.draw()
        return None

    try:
        return curses.wrapper(_curses_main)
    except KeyboardInterrupt:
        pass
    except curses.error:
        print("terminal too small for the interface; resize your window and retry")
    return 0


if __name__ == "__main__":
    sys.exit(main())