#!/usr/bin/env python3
"""TUI to configure omarchy-power behavior.

Edits, per power source (AC / battery), what happens after idle and on lid
close, plus the Omarchy shell idle timings (screensaver / lock).

Applying writes:

  - ~/.config/omarchy/shell.json                  (user, direct)
      idle-sleep plugin entry + idle.screensaver / idle.lock; the shell
      hot-reloads it, so idle changes are live immediately.
  - /etc/systemd/logind.conf.d/20-omarchy-power.conf
      (root, via sudo/pkexec, only when lid settings changed) followed by a
      reload of systemd-logind.

Only the Python standard library is used; no external dependencies.
"""

from __future__ import annotations

import curses
import json
import os
import pwd
import shutil
import subprocess
import sys
import tempfile

APP_TITLE = "omarchy power config"

PLUGIN_ID = "omarchy-power.idle-sleep"
LOGIND_DROPIN = "/etc/systemd/logind.conf.d/20-omarchy-power.conf"

# Actions the idle-sleep plugin accepts (run as `systemctl <action>`).
IDLE_ACTIONS = [
    "ignore",
    "suspend",
    "hibernate",
    "hybrid-sleep",
    "suspend-then-hibernate",
    "poweroff",
]

LOGIND_ACTIONS = [
    "ignore",
    "poweroff",
    "reboot",
    "halt",
    "suspend",
    "hibernate",
    "hybrid-sleep",
    "suspend-then-hibernate",
    "lock",
    "kexec",
]

IDLE_DEFAULTS = {
    "acAction": "ignore",
    "acTimeout": 0,
    "batteryAction": "suspend",
    "batteryTimeout": 1800,
}

LID_DEFAULTS = {
    "HandleLidSwitch": "suspend",
    "HandleLidSwitchExternalPower": "ignore",
    "HandleLidSwitchDocked": "ignore",
}

SHELL_IDLE_DEFAULTS = {"screensaver": 300, "lock": 600}

# (title, [(kind, key, label)]) — kind is "idle" (plugin entry), "lid"
# (logind drop-in) or "shell" (shell.json idle timings).
SECTIONS = [
    ("AC adapter (plugged in)", [
        ("idle", "acAction", "Action after idle"),
        ("idle", "acTimeout", "Idle timeout (minutes)"),
        ("lid", "HandleLidSwitchExternalPower", "Lid close"),
    ]),
    ("Battery (unplugged)", [
        ("idle", "batteryAction", "Action after idle"),
        ("idle", "batteryTimeout", "Idle timeout (minutes)"),
        ("lid", "HandleLidSwitch", "Lid close"),
    ]),
    ("Docked / external display (either source)", [
        ("lid", "HandleLidSwitchDocked", "Lid close"),
    ]),
    ("Omarchy shell idle", [
        ("shell", "screensaver", "Screensaver delay (minutes)"),
        ("shell", "lock", "Screen off / lock (minutes)"),
    ]),
]


def deep_dupe(obj):
    return json.loads(json.dumps(obj))


def user_home():
    """Home of the human user, even when running under sudo."""
    if os.geteuid() == 0:
        sudo_user = os.getenv("SUDO_USER")
        if sudo_user:
            try:
                return pwd.getpwnam(sudo_user).pw_dir
            except KeyError:
                pass
        return "/root"
    return os.path.expanduser("~")


# --------------------------------------------------------------------------- #
# Lid behavior (logind drop-in)
# --------------------------------------------------------------------------- #

def render_lid_dropin(lid):
    lines = [
        "# Generated by omarchy-power-config.",
        "#",
        "# logind picks the key by power source: HandleLidSwitchDocked when docked",
        "# or with more than one display, HandleLidSwitchExternalPower on AC,",
        "# HandleLidSwitch on battery.",
        "[Login]",
    ]
    for key in LID_DEFAULTS:
        lines.append(f"{key}={lid[key]}")
    return "\n".join(lines) + "\n"


def parse_lid_dropin(text):
    lid = dict(LID_DEFAULTS)
    for raw in text.splitlines():
        key, sep, value = raw.strip().partition("=")
        if sep and key in lid and value.strip() in LOGIND_ACTIONS:
            lid[key] = value.strip()
    return lid


def load_lid():
    """Installed drop-in, else the repo template, else built-in defaults."""
    repo = os.path.join(os.path.dirname(os.path.abspath(__file__)),
                        "logind", "20-omarchy-power.conf")
    for path in (LOGIND_DROPIN, repo):
        try:
            with open(path) as fh:
                return parse_lid_dropin(fh.read())
        except OSError:
            continue
    return dict(LID_DEFAULTS)


# --------------------------------------------------------------------------- #
# Shell config (~/.config/omarchy/shell.json)
# --------------------------------------------------------------------------- #

def shell_json_path(home=None):
    return os.path.join(home or user_home(), ".config", "omarchy", "shell.json")


def plugin_dir(home=None):
    return os.path.join(home or user_home(), ".config", "omarchy", "plugins", PLUGIN_ID)


def load_shell_data():
    with open(shell_json_path()) as fh:
        return json.load(fh)


def plugin_entry(data):
    """This plugin's entry in shell.json plugins[], created if missing."""
    plugins = data.setdefault("plugins", [])
    for entry in plugins:
        if isinstance(entry, dict) and entry.get("id") == PLUGIN_ID:
            break
    else:
        entry = {"id": PLUGIN_ID}
        plugins.append(entry)
    for key, value in IDLE_DEFAULTS.items():
        entry.setdefault(key, value)
    return entry


def read_shell_idle(data):
    idle = data.get("idle") or {}
    return {key: int(idle.get(key, default))
            for key, default in SHELL_IDLE_DEFAULTS.items()}


def write_shell_idle(data, screensaver, lock):
    idle = dict(data.get("idle") or {})
    idle["screensaver"] = int(screensaver)
    idle["lock"] = int(lock)
    data["idle"] = idle
    return data


# --------------------------------------------------------------------------- #
# System glue
# --------------------------------------------------------------------------- #

def detect_power_source():
    try:
        for name in os.listdir("/sys/class/power_supply"):
            base = f"/sys/class/power_supply/{name}"
            try:
                with open(f"{base}/type") as fh:
                    if fh.read().strip() not in ("Mains", "USB"):
                        continue
                with open(f"{base}/online") as fh:
                    if fh.read().strip() == "1":
                        return "ac"
            except OSError:
                continue
        return "battery"
    except OSError:
        return "unknown"


def sudo_prefix():
    if os.geteuid() == 0:
        return []
    if shutil.which("sudo"):
        return ["sudo"]
    if shutil.which("pkexec"):
        return ["pkexec"]
    return None


def run_step(cmd):
    print(f"\n> {' '.join(cmd)}")
    result = subprocess.call(cmd)
    if result != 0:
        raise SystemExit(f"command failed with exit code {result}: {' '.join(cmd)}")


def apply_changes(lid, data, lid_changed, shell_idle_changed):
    """Write user shell.json, and the logind drop-in (root) if lid changed."""
    sjson = shell_json_path()
    os.makedirs(os.path.dirname(sjson), exist_ok=True)
    with open(sjson, "w") as fh:
        json.dump(data, fh, indent=2)
        fh.write("\n")
    if os.geteuid() == 0 and os.getenv("SUDO_USER"):
        shutil.chown(sjson, os.getenv("SUDO_USER"), os.getenv("SUDO_USER"))
    print(f"\n> wrote {sjson} (the shell reloads it automatically)")

    if lid_changed:
        prefix = sudo_prefix()
        if prefix is None:
            raise SystemExit("no privilege helper (sudo or pkexec) found to write /etc")
        with tempfile.TemporaryDirectory(prefix="omarchy-power-") as tmp:
            dropin_tmp = os.path.join(tmp, "20-omarchy-power.conf")
            with open(dropin_tmp, "w") as fh:
                fh.write(render_lid_dropin(lid))
            run_step(prefix + ["install", "-m", "0644", "-D", dropin_tmp, LOGIND_DROPIN])
        # Reload, not restart: restarting logind tears down the session.
        run_step(prefix + ["systemctl", "reload", "systemd-logind"])

    # The built-in idle service keeps the screensaver / lock timeouts it
    # started with; a changed value only applies after a shell restart.
    if shell_idle_changed and shutil.which("omarchy"):
        run_step(["omarchy", "restart", "shell"])

    print("\nDone. The new settings are active.")


# --------------------------------------------------------------------------- #
# TUI
# --------------------------------------------------------------------------- #

C_NORMAL = 1
C_TITLE = 2
C_OK = 3
C_WARN = 4
C_ERR = 5
C_DIM = 6


def setup_colors(stdscr):
    if not curses.has_colors():
        return
    curses.start_color()
    try:
        curses.use_default_colors()
    except curses.error:
        pass
    curses.init_pair(C_NORMAL, -1, -1)
    curses.init_pair(C_TITLE, curses.COLOR_CYAN, -1)
    curses.init_pair(C_OK, curses.COLOR_GREEN, -1)
    curses.init_pair(C_WARN, curses.COLOR_YELLOW, -1)
    curses.init_pair(C_ERR, curses.COLOR_RED, -1)
    curses.init_pair(C_DIM, 8, -1)


class App:
    def __init__(self, stdscr, lid, data):
        self.stdscr = stdscr
        self.lid = lid
        self.data = data
        plugin_entry(self.data)
        self.sel = 0
        self.scroll = 0
        self.status = ""
        self.status_color = C_DIM
        self.saved = snapshot(lid, data)
        self.saved_lid = dict(lid)
        self.saved_shell_idle = read_shell_idle(data)
        self.quit = False
        self.power_source = detect_power_source()
        self.plugin_installed = os.path.isdir(plugin_dir())
        self.maxy, self.maxx = stdscr.getmaxyx()

    # -- rows -------------------------------------------------------------- #
    def rows(self):
        rows = []  # (kind, payload) kind in {"head", "idle", "lid", "shell"}
        for title, fields in SECTIONS:
            rows.append(("head", title))
            for kind, key, label in fields:
                rows.append((kind, (key, label)))
        return rows

    def options(self, row):
        kind, (key, _) = row
        if kind == "lid":
            return LOGIND_ACTIONS
        if kind == "idle" and key.endswith("Action"):
            return IDLE_ACTIONS
        return None

    def is_enum(self, row):
        return self.options(row) is not None

    def field_value(self, row):
        kind, payload = row
        if kind == "head":
            return ""
        key = payload[0]
        if kind == "lid":
            return self.lid[key]
        if kind == "idle":
            val = plugin_entry(self.data)[key]
            return str(val) if key.endswith("Action") else str(int(val) // 60)
        if kind == "shell":
            return str(read_shell_idle(self.data)[key] // 60)
        return ""

    def field_set(self, row, value):
        kind, (key, _) = row
        if kind == "lid":
            self.lid[key] = value
        elif kind == "idle":
            entry = plugin_entry(self.data)
            entry[key] = value if key.endswith("Action") else int(value) * 60
        elif kind == "shell":
            idle = read_shell_idle(self.data)
            idle[key] = int(value) * 60
            write_shell_idle(self.data, idle["screensaver"], idle["lock"])

    # -- events ------------------------------------------------------------ #
    def move(self, delta):
        rows = self.rows()
        total = len(rows) - 1
        self.sel = max(0, min(total, self.sel + delta))
        page = max(self.maxy - 3, 1)
        if self.sel < self.scroll:
            self.scroll = self.sel
        elif self.sel >= self.scroll + page:
            self.scroll = self.sel - page + 1

    def handle(self, ch):
        rows = self.rows()
        row = rows[self.sel]
        editable = row[0] != "head"
        if ch in (ord("q"), 27):
            if self.dirty():
                if yesno(self.stdscr, "Quit", "You have unsaved changes.\nQuit anyway?"):
                    self.quit = True
            else:
                self.quit = True
        elif ch in (curses.KEY_UP, ord("k")):
            self.move(-1)
        elif ch in (curses.KEY_DOWN, ord("j")):
            self.move(1)
        elif ch in (curses.KEY_ENTER, 10, 13, curses.KEY_RIGHT, ord("l")):
            if editable:
                options = self.options(row)
                if options:
                    current = self.field_value(row)
                    idx = options.index(current) if current in options else 0
                    chosen = pick_option(self.stdscr, "Choose action", options, idx)
                    if chosen is not None:
                        self.field_set(row, options[chosen])
                        self.status = ""
                else:
                    result = number_input(self.stdscr, "Enter minutes", self.field_value(row))
                    if result is not None:
                        self.field_set(row, result)
                        self.status = ""
        elif ch in (curses.KEY_LEFT, ord("h")):
            options = self.options(row) if editable else None
            if options:
                current = self.field_value(row)
                idx = options.index(current) if current in options else 0
                self.field_set(row, options[(idx - 1) % len(options)])
                self.status = ""
        elif ch in (ord("a"), ord("A")):
            self.do_apply()
        elif ch in (ord("r"), ord("R")):
            if yesno(self.stdscr, "Reset",
                     "Reset to the repository defaults? Changes are applied\n"
                     "only after you press a."):
                self.lid = dict(LID_DEFAULTS)
                plugin_entry(self.data).update(IDLE_DEFAULTS)
                write_shell_idle(self.data,
                                 SHELL_IDLE_DEFAULTS["screensaver"],
                                 SHELL_IDLE_DEFAULTS["lock"])
                self.status = "Reset to defaults. Press a to apply."
                self.status_color = C_WARN
        elif ch == curses.KEY_RESIZE:
            self.maxy, self.maxx = self.stdscr.getmaxyx()
        else:
            self.show_status("a apply · r reset defaults · q quit", C_DIM)

    def dirty(self):
        return snapshot(self.lid, self.data) != self.saved

    def show_status(self, text, color):
        self.status = text
        self.status_color = color

    def do_apply(self):
        if not self.dirty():
            self.show_status("Nothing to apply — no changes yet.", C_WARN)
            return
        self.show_status("Applying…", C_DIM)
        self.draw()
        suspend_tui(self.stdscr)
        try:
            apply_changes(self.lid, self.data, self.lid != self.saved_lid,
                          read_shell_idle(self.data) != self.saved_shell_idle)
            self.saved = snapshot(self.lid, self.data)
            self.saved_lid = dict(self.lid)
            self.saved_shell_idle = read_shell_idle(self.data)
            self.show_status("Applied. Settings are active now.", C_OK)
        except SystemExit as exc:
            self.show_status(f"Apply failed: {exc}\nPress any key to continue", C_ERR)
            self.stdscr.getch()
        finally:
            resume_tui(self.stdscr)

    # -- drawing ----------------------------------------------------------- #
    def draw(self):
        self.maxy, self.maxx = self.stdscr.getmaxyx()
        stdscr = self.stdscr
        stdscr.erase()

        header = f" {APP_TITLE} — power: {self.power_source}"
        if self.dirty():
            header += "  [unsaved]"
        try:
            stdscr.addnstr(0, 0, header, self.maxx,
                           curses.color_pair(C_TITLE) | curses.A_BOLD)
        except curses.error:
            pass

        rows = self.rows()
        page = self.maxy - 3
        if page < 1:
            page = 1
        if self.scroll > len(rows) - page:
            self.scroll = max(0, len(rows) - page)
        visible = rows[self.scroll:self.scroll + page]

        max_label = max(len(payload[-1])
                        for kind, payload in rows if kind != "head")
        y = 1
        for row in visible:
            kind, payload = row
            selected = (self.scroll + y - 1) == self.sel
            if kind == "head":
                line = f" {payload}"
                attr = curses.color_pair(C_TITLE) | curses.A_BOLD | curses.A_UNDERLINE
                if selected:
                    attr |= curses.A_REVERSE
                try:
                    stdscr.addnstr(y, 0, line, self.maxx, attr)
                except curses.error:
                    pass
                y += 1
                continue
            label = payload[-1]
            value = self.field_value(row)
            hint = "*" if self.is_enum(row) else "▶"
            line = f"  {label.ljust(max_label)}  {value}  {hint}"
            attr = curses.A_REVERSE if selected else curses.color_pair(C_NORMAL)
            try:
                stdscr.addnstr(y, 0, line, self.maxx, attr)
            except curses.error:
                pass
            y += 1

        status = self.status
        color = self.status_color
        if not status and not self.plugin_installed:
            status = f"idle-sleep plugin not installed ({plugin_dir()}); run install.sh"
            color = C_WARN
        status = status or "a apply · r reset defaults · q quit"
        try:
            stdscr.addnstr(self.maxy - 2, 0, f" {status}", self.maxx,
                           curses.color_pair(color))
        except curses.error:
            pass

        footer = ("↑↓ move · ↲ edit / choose · a apply · "
                  "r reset · q quit")
        try:
            stdscr.addnstr(self.maxy - 1, 0, footer, self.maxx,
                           curses.color_pair(C_DIM))
        except curses.error:
            pass
        stdscr.refresh()


def snapshot(lid, data):
    return json.dumps(lid, sort_keys=True), json.dumps(data, sort_keys=True)


def suspend_tui(stdscr):
    curses.def_prog_mode()
    curses.endwin()


def resume_tui(stdscr):
    curses.reset_prog_mode()
    stdscr.refresh()


def center_win(stdscr, height, width):
    maxy, maxx = stdscr.getmaxyx()
    height = min(height, maxy)
    width = min(width, maxx)
    if width < 20:
        width = maxx
    win = curses.newwin(height, width,
                        (maxy - height) // 2, (maxx - width) // 2)
    win.bkgd(" ", curses.color_pair(C_NORMAL))
    return win


def popup(stdscr, title, nlines):
    width = min(60, stdscr.getmaxyx()[1] - 2)
    height = nlines + 4
    win = center_win(stdscr, height, width)
    h, w = win.getmaxyx()
    win.box()
    safe_add(win, 1, 1, title, w - 2, curses.color_pair(C_TITLE) | curses.A_BOLD)
    win.refresh()
    return win, h, w


def safe_add(win, y, x, text, maxlen, attr=0):
    try:
        win.addnstr(y, x, text, maxlen, attr)
    except curses.error:
        pass


def pick_option(stdscr, title, options, current):
    win, height, width = popup(stdscr, title, len(options))
    sel = max(0, min(current, len(options) - 1))
    while True:
        win.erase()
        win.box()
        safe_add(win, 1, 1, title, width - 2,
                 curses.color_pair(C_TITLE) | curses.A_BOLD)
        for i, opt in enumerate(options):
            if i >= height - 3:
                break
            line = f"  {opt}".ljust(width - 8)
            attr = curses.A_REVERSE if i == sel else curses.color_pair(C_NORMAL)
            safe_add(win, 2 + i, 1, line, width - 2, attr)
        win.refresh()
        ch = stdscr.getch()
        if ch == curses.KEY_UP:
            sel = max(0, sel - 1)
        elif ch == curses.KEY_DOWN:
            sel = min(len(options) - 1, sel + 1)
        elif ch in (curses.KEY_ENTER, 10, 13, ord(" ")):
            return sel
        elif ch in (27, ord("q")):
            return None


def number_input(stdscr, title, current):
    win, height, width = popup(stdscr, title, 4)
    buf = list(current) if current.isdigit() else []
    old_cursor = curses.curs_set(1)
    try:
        while True:
            win.erase()
            win.box()
            value = "".join(buf) or "0"
            safe_add(win, 1, 1, title, width - 2,
                     curses.color_pair(C_TITLE) | curses.A_BOLD)
            safe_add(win, 2, 1, f"Minutes: {value}", width - 2)
            line = "left/right move, digits edit, ENTER ok, ESC cancel"
            safe_add(win, 3, 1, line, width - 2, curses.color_pair(C_DIM))
            win.move(2, 11 + len(value))
            win.refresh()
            ch = stdscr.getch()
            if ch in (curses.KEY_ENTER, 10, 13):
                try:
                    return max(int("".join(buf) or "0"), 0)
                except ValueError:
                    return None
            elif ch == 27:
                return None
            elif ch in (curses.KEY_BACKSPACE, 8, 127):
                if buf:
                    buf.pop()
            elif 48 <= ch <= 57:
                buf.append(chr(ch))
    finally:
        try:
            curses.curs_set(old_cursor)
        except curses.error:
            pass


def yesno(stdscr, title, message):
    win, height, width = popup(stdscr, title, len(message.splitlines()) + 1)
    while True:
        win.erase()
        win.box()
        safe_add(win, 1, 1, title, width - 2,
                 curses.color_pair(C_TITLE) | curses.A_BOLD)
        for i, line in enumerate(message.splitlines()):
            safe_add(win, 2 + i, 1, line, width - 2)
        safe_add(win, 3 + i + 1, 1, "y=yes  n=no  esc=cancel", width - 2,
                 curses.color_pair(C_DIM))
        win.refresh()
        ch = stdscr.getch()
        if ch in (ord("y"), ord("Y")):
            return True
        if ch in (ord("n"), ord("N"), 27):
            return False


def main():
    lid = load_lid()
    try:
        data = load_shell_data()
    except FileNotFoundError:
        # The shell does not merge its defaults into a user shell.json, so a
        # new file has to start from the packaged one.
        omarchy = os.getenv("OMARCHY_PATH", "/usr/share/omarchy")
        try:
            with open(os.path.join(omarchy, "config", "omarchy", "shell.json")) as fh:
                data = json.load(fh)
        except (OSError, ValueError):
            data = {"version": 1}
    except (OSError, ValueError) as exc:
        print(f"cannot read {shell_json_path()}: {exc}", file=sys.stderr)
        return 1

    def _curses_main(stdscr):
        setup_colors(stdscr)
        try:
            curses.curs_set(0)
        except curses.error:
            pass
        app = App(stdscr, lid, data)
        app.draw()
        while not app.quit:
            ch = stdscr.getch()
            app.handle(ch)
            app.draw()
        return None

    try:
        return curses.wrapper(_curses_main)
    except KeyboardInterrupt:
        pass
    except curses.error:
        print("terminal too small for the interface; resize your window and retry")
    return 0


if __name__ == "__main__":
    sys.exit(main())